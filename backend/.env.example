# Copy to .env. If SMTP_HOST is empty, emails are only printed in the backend terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=hr@akshara.example
# Code HR users must enter when registering. CHANGE THIS.
HR_SIGNUP_CODE=akshara-hr
# AI interview. Leave the key empty to turn the AI interview step off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_INTERVIEW=on
AI_INTERVIEW_QUESTIONS=6